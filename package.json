{
  "name": "qwen-image-edit",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "vite",
    "dev:server": "bun run --watch server/index.ts",
    "build": "npm run asbuild:release && vite build",
    "preview": "vite preview",
    "server": "bun run server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "asbuild:debug": "node node_modules/assemblyscript/bin/asc.js assembly/image-resize.ts -o public/wasm/image-resize.debug.wasm --debug",
    "asbuild:release": "node node_modules/assemblyscript/bin/asc.js assembly/image-resize.ts -o public/wasm/image-resize.wasm --optimize --runtime stub",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release"
  },
  "dependencies": {
    "@gradio/client": "^2.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@huggingface/inference": "^3.9.0",
    "hono": "^4.7.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.11.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.2.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.16",
    "wrangler": "^4.54.0",
    "vite-plugin-wasm": "^3.5.0",
    "assemblyscript": "^0.28.9"
  }
}
